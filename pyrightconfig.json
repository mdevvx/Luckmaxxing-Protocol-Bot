{
  // discord.py types Interaction.guild, bot.user, ApplicationInfo.owner,
  // Bot.get_cog(), ctx.author, etc. as Optional or a broad union. These slash
  // commands are guild-only and run after login, so the None / wrong-subtype
  // branch never happens at runtime. Silence that noise below; genuine logic
  // errors still surface.
  "pythonVersion": "3.13",
  "typeCheckingMode": "basic",

  "reportMissingImports": true,
  "reportMissingModuleSource": false,

  "reportOptionalMemberAccess": "none",
  "reportOptionalSubscript": "none",
  "reportOptionalCall": "none",
  "reportOptionalIterable": "none",
  "reportOptionalOperand": "none",
  "reportArgumentType": "none",
  "reportAttributeAccessIssue": "none"
}
